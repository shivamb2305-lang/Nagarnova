# ==============================================================================
# CivicLens - Environment Variables Configuration
# Tagline: “See the Problem. Report It. Make the City Better.”
# ==============================================================================
# Copy this file to `server/.env` and `client/.env` respectively.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (`client/.env`)
# ------------------------------------------------------------------------------
# Real Phone OTP Authentication via Firebase Phone Authentication:
# 1. Open Firebase Console: https://console.firebase.google.com
# 2. Add or select a project.
# 3. Under Build -> Authentication -> Sign-in method -> Enable "Phone".
# 4. Under Project Settings -> General -> Your apps -> Add Web App (</>).
# 5. Copy and paste the web configuration keys here:

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id_here

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (`server/.env`)
# ------------------------------------------------------------------------------
PORT=5000
CLIENT_URL=http://localhost:5173

# Firebase Authentication Server Verification (Matches VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=your_project_id
# Optional: Path to serviceAccountKey.json or JSON string
FIREBASE_SERVICE_ACCOUNT=

# MongoDB Atlas Connection
# Replace <username> and <password> with your Atlas DB credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/civiclens?retryWrites=true&w=majority

# JWT Session Secret
JWT_SECRET=civiclens_super_secret_production_jwt_key_change_me_in_prod
JWT_EXPIRES_IN=7d

# Cloudinary Media Storage (Optional, for persistent cloud photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Vision AI Civic Issue Detection
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-2.5-flash

# Reverse Geocoding User Agent
GEOCODING_USER_AGENT=CivicLensPortal/1.0
